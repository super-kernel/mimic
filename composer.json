{
    "name": "super-kernel/mimic",
    "description": "Source preparation with pluggable transformations, source-hash-validated file proxies, and stream fallback for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "ext-reflection": "*",
        "super-kernel/contract": "dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "nikic/php-parser": "^5.9.0",
        "phpunit/phpunit": "^13.4.5"
    },
    "suggest": {
        "ext-zend-opcache": "Invalidates published proxy files in OPcache so replaced proxies are recompiled."
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Mimic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\Mimic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
